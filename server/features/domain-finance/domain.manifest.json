      "routes": "children/payments/routes.js",
      "enabled": true
    },
    {
      "id": "escrow-payment",
      "name": "RBI Escrow & Section 194-O TDS Compliance Engine",
      "basePath": "/api/escrow",
      "folder": "children/escrow",
      "routes": "children/escrow/routes.js",
      "enabled": true
    }
  ]
}
